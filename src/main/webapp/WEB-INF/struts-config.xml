<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE struts-config PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 1.3//EN"
        "http://struts.apache.org/dtds/struts-config_1_3.dtd">

<struts-config>

  <form-beans>
    <form-bean name="productForm" type="com.example.legacy.form.ProductForm"/>
    <form-bean name="orderForm" type="com.example.legacy.form.OrderForm"/>
  </form-beans>

  <global-forwards>
    <forward name="productList" path="/productList.do" redirect="true"/>
    <forward name="orderList" path="/orderList.do" redirect="true"/>
  </global-forwards>

  <action-mappings>

    <!-- 商品(在庫)一覧・検索 -->
    <action path="/productList"
            type="com.example.legacy.action.ProductListAction"
            scope="request">
      <forward name="success" path="/jsp/productList.jsp"/>
    </action>

    <!-- 商品の新規/編集フォーム表示 -->
    <action path="/productEdit"
            type="com.example.legacy.action.ProductEditAction"
            name="productForm"
            scope="request"
            validate="false">
      <forward name="success" path="/jsp/productForm.jsp"/>
    </action>

    <!-- 商品の保存(新規/更新) -->
    <action path="/productSave"
            type="com.example.legacy.action.ProductSaveAction"
            name="productForm"
            scope="request"
            input="/jsp/productForm.jsp"
            validate="false">
      <forward name="success" path="/productList.do" redirect="true"/>
      <forward name="failure" path="/jsp/productForm.jsp"/>
    </action>

    <!-- 注文一覧 -->
    <action path="/orderList"
            type="com.example.legacy.action.OrderListAction"
            scope="request">
      <forward name="success" path="/jsp/orderList.jsp"/>
    </action>

    <!-- 注文の新規作成フォーム表示 -->
    <action path="/orderEdit"
            type="com.example.legacy.action.OrderEditAction"
            name="orderForm"
            scope="request"
            validate="false">
      <forward name="success" path="/jsp/orderForm.jsp"/>
    </action>

    <!-- 注文の保存（在庫引き落とし処理を含む） -->
    <action path="/orderSave"
            type="com.example.legacy.action.OrderSaveAction"
            name="orderForm"
            scope="request"
            input="/jsp/orderForm.jsp"
            validate="false">
      <forward name="success" path="/orderList.do" redirect="true"/>
      <forward name="failure" path="/jsp/orderForm.jsp"/>
    </action>

  </action-mappings>

</struts-config>
